<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers run in the compiler host, not in the published server. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- RS1036: a project that contains an analyzer or source generator must
         opt in to the extended analyzer rules. This turns on RS1035, which
         bans host-affecting APIs (Console, Environment, File/Directory IO,
         Random, Assembly.Load, CultureInfo.Current*) inside the compiler
         process. This generator already avoids all of them; it reads only the
         Compilation and formats with CultureInfo.InvariantCulture. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time-only Roslyn API. PrivateAssets keeps it out of the server
         runtime and therefore out of NativeAOT application closure. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- RS2008: release tracking counts as enabled only when BOTH files reach
         the compiler as AdditionalFiles, which is also what keeps RS2000/RS2001
         checking every PMH* descriptor against its declared category and
         severity. Microsoft.CodeAnalysis.Analyzers arrives transitively through
         Microsoft.CodeAnalysis.CSharp and auto-includes these two names when
         they exist, but they are declared explicitly so the build does not
         depend on that transitive package layout. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
