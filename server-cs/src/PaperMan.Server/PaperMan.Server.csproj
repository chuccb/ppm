<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PaperMan.Protocol/PaperMan.Protocol.csproj" />
    <!-- 10.0.12 = 2026-09-08 最新穩定; 其 transitive 依賴
         SQLitePCLRaw.bundle_e_sqlite3 >= 2.1.12 已修復
         CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (舊版 NU1903)。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Keep first-run initialization self-contained in both dotnet run and
       published deployments. The server never needs Python or a separately
       prepared SQLite file merely to start. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../db/schema.sql" Link="Database/schema.sql" />
    <EmbeddedResource Include="../../../db/packets.tsv" Link="Database/packets.tsv" />
  </ItemGroup>

</Project>
